algoritmo Impares
    início
        inteiro num, soma
        soma = 0
        faça {
            escreva("Digite um numero");
            leia(num)
            se (num % 2!= 0) {
                soma-soma+num
            }
        }
        enquanto(num!=0){
            escreva("A soma dos numeros impares e: " + soma)
            
        }
    fim