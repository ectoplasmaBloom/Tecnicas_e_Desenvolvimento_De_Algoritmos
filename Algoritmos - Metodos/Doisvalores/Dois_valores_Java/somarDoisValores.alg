algoritmo somarDoisValores
real x,y
    início
        escreva ("entre com o 1° valor:")
        leia (x)
        escreva ("entre com o 2° valor")
        leia (y)        
        escreva ("a soma é" + somaDoisValores(x, y))
    fim

real somaDoisValores(real a, real b)
    retorne a+b
    fim