algoritmo exemplo2
caractere msg
inteiro n    
    início
        escreva("Digite um numero: ")
        leia (n)
        escreva("Digite um texto: ")
        leia(msg)
        exibirMensagem(msg,n)
    fim
void exibirMensagem(caractere texto, inteiro num)
        escreva ("Mensagem "+ texto + "numero"+ num)
    fim